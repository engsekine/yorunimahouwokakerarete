{
    "name": "yorunimahouwokakerarete",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome lint .",
        "lint:fix": "biome lint . --write",
        "lint:markup": "markuplint \"./src/**/*.{jsx,tsx}\"",
        "format": "biome format . --write",
        "format:check": "biome format .",
        "check": "biome check .",
        "check:fix": "biome check . --write --unsafe",
        "type-check": "tsc --noEmit",
        "test": "vitest run --project=unit",
        "test:watch": "vitest --project=unit",
        "test:coverage": "vitest run --project=unit --coverage",
        "test:storybook": "vitest run --project=storybook",
        "test:storybook:ui": "vitest --project=storybook --ui",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:a11y": "playwright test tests/a11y",
        "test:all": "npm run test && npm run test:storybook && npm run test:e2e",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "ci:storybook": "storybook build && npm run test:storybook",
        "validate": "npm run type-check && npm run check && npm run lint:markup && npm run test"
    },
